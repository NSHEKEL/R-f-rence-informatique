<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- The window has no action bar, so the options live behind this
         discreet handle: without it the server address could never be
         changed again. It hangs on the right edge, clear of the page header
         and of the bottom tab bar (À propos sits in that corner). -->
    <Button
        android:id="@+id/options"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:alpha="0.35"
        android:padding="0dp"
        android:text="@string/options"
        android:textSize="18sp"
        android:contentDescription="@string/options_hint" />
</FrameLayout>
